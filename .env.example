# Copy to .env and fill in. Never commit .env.

# Database: leave unset for local SQLite, or point at PostgreSQL.
# DATABASE_URL=postgresql+psycopg://chakravyuh:chakravyuh@localhost:5432/chakravyuh

# Admin key for analyst-only routes (feedback list, tester list). Change it.
ADMIN_API_KEY=change-me-admin

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Require a tester API key on write routes (turn on for the public beta).
REQUIRE_API_KEY=false

# Store raw message text in the database. Set false in production: text is scored in memory only.
STORE_MESSAGE_TEXT=true

# Optional: an OpenAI-compatible LLM for the attacker agents to paraphrase scams (more realistic data).
# Groq example: https://api.groq.com/openai/v1  with model llama-3.1-8b-instant
# Local Ollama:  http://localhost:11434/v1     with model qwen2.5:7b
CHAKRAVYUH_LLM_BASE_URL=
CHAKRAVYUH_LLM_API_KEY=
CHAKRAVYUH_LLM_MODEL=
