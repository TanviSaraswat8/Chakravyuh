# Copy to .env and fill in. Never commit .env.

# Database: leave unset for local SQLite, or point at PostgreSQL.
# DATABASE_URL=postgresql+psycopg://chakravyuh:chakravyuh@localhost:5432/chakravyuh
# (Docker stack database from your machine: add docker-compose.dbport.yml, then use port 55432)

# Accounts. The old shared ADMIN_API_KEY is retired and ignored. To create the first admin either set
# both values below (a weak or default password stops the API from starting), or run:
#   cd backend && python -m app.manage create-user --email you@example.com --role ADMIN
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Sign-in cookies. Keep COOKIE_SECURE=true anywhere served over HTTPS (required in production).
# Plain-HTTP local development needs false. Use COOKIE_SAMESITE=none (with secure) only when the web
# app and API are on different sites.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Allow self sign-up (new accounts are ANALYSTs who see only their own sessions).
ALLOW_REGISTRATION=true
# Only behind a reverse proxy you control: trust its X-Forwarded-For for per-client rate limits.
TRUST_FORWARDED_FOR=false

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Store raw message text in the database. Set false in production: text is scored in memory only.
STORE_MESSAGE_TEXT=true

# Optional: an OpenAI-compatible LLM for the attacker agents to paraphrase scams (more realistic data).
# Groq example: https://api.groq.com/openai/v1  with model llama-3.1-8b-instant
# Local Ollama:  http://localhost:11434/v1     with model qwen2.5:7b
CHAKRAVYUH_LLM_BASE_URL=
CHAKRAVYUH_LLM_API_KEY=
CHAKRAVYUH_LLM_MODEL=
