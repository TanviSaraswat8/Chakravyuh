# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Data and local databases (regenerate with `make data`)
backend/data/*
!backend/data/.gitkeep
backend/*.db
*.db-journal

# Node
node_modules/
frontend/dist/

# Env and editor
.env
.env.*
!.env.example
.DS_Store
.idea/

# Sentinel training outputs
sentinel/outputs/
sentinel/*.gguf

# Local validation output
validation-report.txt
validation-build.log

# Real and synthetic datasets: never committed. Provenance, licences and SHA-256 live in
# data/registry/*.json; fetch with scripts/fetch_real_datasets.py.
data/real/**/raw/
data/synthetic/**/*
!data/synthetic/**/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*
!data/splits/.gitkeep

# Real-data Sentinel builds (derived from data/processed; rebuild with sentinel/build_sft_real.py)
sentinel/sft_real/
